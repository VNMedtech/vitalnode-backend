DATABASE_URL=postgresql://user:pass@localhost:5432/medical_local
JWT_SECRET=change-me-min-32-characters-long!!
JWT_REFRESH_SECRET=change-me-min-32-characters-long!!
PORT=5010
NODE_ENV=development

# Core runtime
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false

# Auth & security
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=10
PASSWORD_RESET_TOKEN_EXPIRES_IN_MINUTES=30
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=20

# S3 (file uploads) — use a dedicated IAM user with S3 permissions only
AWS_S3_REGION=ap-south-1
AWS_S3_BUCKET_NAME=your-bucket-name
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_SIGNED_URL_EXPIRES_IN_SECONDS=3600

# SES (transactional email) — use a separate IAM user with SES permissions only
AWS_SES_REGION=ap-south-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
SES_FROM_EMAIL=noreply@yourdomain.com
SES_FROM_NAME=Medical Equipment Marketplace
SES_REPLY_TO_EMAIL=support@yourdomain.com
# Password-reset / deep-link bases (portal-aware reset + notification CTAs)
WEB_APP_BASE_URL=http://localhost:5173
WEB_APP_STORE_URL=http://localhost:5173
WEB_APP_SELLER_URL=http://localhost:5174
WEB_APP_ADMIN_URL=http://localhost:5176
WEB_APP_DELIVERY_URL=http://localhost:5175

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SYSTEM_ACTOR_USER_ID=

# Unpaid checkout TTL — auto-cancel PENDING_PAYMENT orders older than this
PENDING_PAYMENT_TTL_MINUTES=30
PENDING_PAYMENT_SWEEP_INTERVAL_MS=300000

# Read in-app notification TTL — hard-delete read notifications older than this
READ_NOTIFICATION_TTL_DAYS=30
READ_NOTIFICATION_SWEEP_INTERVAL_MS=86400000

# Production bootstrap (npm run db:bootstrap) — creates admin + system actor
# Re-run safe: existing admin password is not changed
BOOTSTRAP_CONFIRM=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_FIRST_NAME=Platform
# BOOTSTRAP_ADMIN_LAST_NAME=Administrator
# BOOTSTRAP_ADMIN_PHONE_NUMBER=
# BOOTSTRAP_SYSTEM_ACTOR_EMAIL=system@medical-marketplace.local
